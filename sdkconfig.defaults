# Main task needs larger stack for TROPIC01 crypto operations
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_FREERTOS_HZ=1000
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_ESPTOOLPY_FLASHSIZE_DETECT=n
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_TINYUSB=y
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_HID_ENABLED=y
CONFIG_TINYUSB_CDC_COUNT=1
CONFIG_TINYUSB_HID_COUNT=2
CONFIG_TINYUSB_CDC_RX_BUFSIZE=256
CONFIG_TINYUSB_CDC_TX_BUFSIZE=256
CONFIG_TINYUSB_HID_BUFSIZE=64
CONFIG_USJ_ENABLE_USB_SERIAL_JTAG=n
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG_ENABLED=n
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=n
CONFIG_ESP_CONSOLE_NONE=y
CONFIG_ESP_CONSOLE_USB_CDC=n
CONFIG_OPENTHREAD_ENABLED=n
CONFIG_CDC_FEATURE_SSH=n
CONFIG_CDC_FEATURE_CA=n
CONFIG_CDC_FEATURE_TOTP=y
CONFIG_CDC_FEATURE_FIDO2=y
CONFIG_EINK_SPI_MOSI=13
CONFIG_EINK_SPI_CLK=12
CONFIG_EINK_SPI_CS=41
CONFIG_EINK_DC=45
CONFIG_EINK_RST=46
CONFIG_EINK_BUSY=42
CONFIG_EINK_SPI_MISO=11
CONFIG_EINK_SPI_CS2=-1
