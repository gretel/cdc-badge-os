#!/bin/bash
# Prevent pushing feature/security branch to GitHub

remote="$1"

# Check if pushing to GitHub
if [[ "$remote" == "github" || "$remote" == *"github.com"* ]]; then
    while read local_ref local_sha remote_ref remote_sha; do
        if [[ "$local_ref" == *"feature/security"* ]]; then
            echo "ERROR: Pushing feature/security to GitHub is not allowed!"
            exit 1
        fi
    done
fi

exit 0
